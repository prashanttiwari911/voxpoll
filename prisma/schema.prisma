// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

// We use Strings for enum fields to keep migrations simple during prototyping.
// Possible values are documented via comments below.

// Role: "USER" | "ADMIN" | "MODERATOR"
// PollStatus: "DRAFT" | "PUBLISHED" | "CLOSED"
// NotificationType: "VOTE" | "COMMENT" | "REPLY" | "LIKE" | "SYSTEM"

// ---------------------------------------------------------------------------
// Auth Models (NextAuth adapter)
// ---------------------------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// User
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // Profile fields
  age        Int?
  address    String? // free-text region / city
  gender     String? // e.g. MALE, FEMALE, OTHER, PREFER_NOT_TO_SAY
  occupation String?

  // Role: "USER" | "ADMIN" | "MODERATOR"
  role String @default("USER")

  deletedAt DateTime?

  // Relations
  accounts      Account[]
  sessions      Session[]
  polls         Poll[]
  votes         Vote[]
  comments      Comment[]
  commentLikes  CommentLike[]
  bookmarks     Bookmark[]
  notifications Notification[]
  auditLogs     AuditLog[]
}

// ---------------------------------------------------------------------------
// Tag
// ---------------------------------------------------------------------------

model Tag {
  id    String     @id @default(cuid())
  name  String     @unique
  polls PollTag[]
}

// ---------------------------------------------------------------------------
// Poll
// ---------------------------------------------------------------------------

model Poll {
  id          String    @id @default(cuid())
  question    String
  description String?
  category    String    // "EDUCATION" | "SPORTS" | "POLITICS" | "BOOKS" | "TECHNOLOGY" | "HEALTH" | "OTHER"

  // Lifecycle
  // status: "DRAFT" | "PUBLISHED" | "CLOSED"
  status      String    @default("PUBLISHED")
  closesAt    DateTime? // null = never closes automatically
  scheduledAt DateTime? // future publish date (for DRAFT → PUBLISHED transition)
  
  // Short code for joining
  shortCode   String?   @unique

  // Media & multi-choice
  imageUrl       String?
  isMultipleChoice Boolean @default(false)
  maxChoices     Int     @default(1) // relevant only when isMultipleChoice = true

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  creatorId String
  deletedAt DateTime?
  creator   User      @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  options       Option[]
  votes         Vote[]
  comments      Comment[]
  bookmarks     Bookmark[]
  tags          PollTag[]
  notifications Notification[]
}

// ---------------------------------------------------------------------------
// PollTag (many-to-many join)
// ---------------------------------------------------------------------------

model PollTag {
  pollId String
  tagId  String

  poll Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([pollId, tagId])
}

// ---------------------------------------------------------------------------
// Option
// ---------------------------------------------------------------------------

model Option {
  id     String @id @default(cuid())
  text   String
  pollId String
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes  Vote[]
}

// ---------------------------------------------------------------------------
// Vote  (supports both single-choice and multi-choice)
// ---------------------------------------------------------------------------

model Vote {
  id        String   @id @default(cuid())
  userId    String
  pollId    String
  optionId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option Option @relation(fields: [optionId], references: [id], onDelete: Cascade)

  // One row per option selected — uniqueness enforced per option to allow multi-choice
  @@unique([userId, pollId, optionId])
}

// ---------------------------------------------------------------------------
// Comment  (nested via self-relation)
// ---------------------------------------------------------------------------

model Comment {
  id        String   @id @default(cuid())
  pollId    String
  userId    String
  text      String
  likes     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Self-relation for threaded replies
  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies  Comment[] @relation("CommentReplies")

  // Sentiment from VADER microservice (nullable until analysed)
  sentimentScore Float?
  // "POSITIVE" | "NEGATIVE" | "NEUTRAL" | "COMPOUND"
  sentimentLabel String?

  poll         Poll          @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  commentLikes CommentLike[]
}

// ---------------------------------------------------------------------------
// CommentLike
// ---------------------------------------------------------------------------

model CommentLike {
  id        String   @id @default(cuid())
  userId    String
  commentId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
}

// ---------------------------------------------------------------------------
// Bookmark
// ---------------------------------------------------------------------------

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  pollId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  poll Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@unique([userId, pollId])
}

// ---------------------------------------------------------------------------
// Notification
// ---------------------------------------------------------------------------

model Notification {
  id        String   @id @default(cuid())
  userId    String   // recipient
  // type: "VOTE" | "COMMENT" | "REPLY" | "LIKE" | "SYSTEM"
  type      String
  message   String
  isRead    Boolean  @default(false)
  pollId    String?  // optional link to poll
  createdAt DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  poll Poll? @relation(fields: [pollId], references: [id], onDelete: SetNull)
}

// ---------------------------------------------------------------------------
// AuditLog
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  // null for anonymous/system actions
  action    String   // e.g. "CREATE_POLL", "DELETE_POLL", "ADMIN_BAN_USER"
  entity    String   // e.g. "Poll", "User", "Comment"
  entityId  String?  // ID of the affected record
  metadata  String?  // JSON blob — additional context
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}
